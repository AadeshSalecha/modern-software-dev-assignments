+  // INC-2231: the router dropped endpoint changes as stale. Publish every endpoint's
+  // current state once more; the router applies it by its own rules. Runs once per store.
+  republishEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'republish_endpoints_2231'")
+        .get();
+      if (done) return;
+      const rows = this.db.prepare("select id from endpoints order by id").all() as { id: string }[];
+      for (const row of rows) this.enqueue("endpoint.changed", now, { endpoint: this.endpoint(row.id) });
+      this.db
+        .prepare("insert into meta (key, value) values ('republish_endpoints_2231', 1)")
+        .run();
+    });
+  }
