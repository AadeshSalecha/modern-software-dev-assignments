+  // Once per store: tell the router the current state of every endpoint, because the
+  // shipped release's router may have dropped changes as stale. Safe on every start.
+  resyncEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'endpoints_resynced'")
+        .get();
+      if (done) return;
+      const rows = this.db.prepare("select id from endpoints order by id").all() as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        if (endpoint) this.enqueue("endpoint.changed", now, { endpoint });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('endpoints_resynced', 1)")
+        .run();
+    });
+  }
+
