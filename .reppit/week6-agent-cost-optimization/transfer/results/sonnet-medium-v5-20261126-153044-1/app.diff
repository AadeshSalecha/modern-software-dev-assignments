+  // One-time (per store) resync: endpoint changes the router may have dropped as
+  // stale are sent again as the api's current state, marked authoritative.
+  resyncEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'endpoint_resync'")
+        .get();
+      if (done) return;
+      const rows = this.db.prepare("select id from endpoints order by id").all() as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        this.enqueue("endpoint.changed", now, { endpoint: { ...endpoint, resync: true } });
+      }
+      this.db.prepare("insert into meta (key, value) values ('endpoint_resync', 1)").run();
+    });
+  }
+
   enqueue(type: string, now: number, data: unknown): void {
