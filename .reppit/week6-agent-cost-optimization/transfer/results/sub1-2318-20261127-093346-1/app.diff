@@ -216,6 +216,61 @@
       .run(status, seq);
   }
 
+  // Once, when this release first starts on a store written by an older one:
+  // tell the router which events each completed off period owed its endpoint.
+  // The marker is written in the same transaction as the messages.
+  backfillOwed(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'owed_backfill'")
+        .get();
+      if (done) return;
+      this.db
+        .prepare("insert into meta (key, value) values ('owed_backfill', 1)")
+        .run();
+      const history = this.db
+        .prepare(
+          "select endpoint_id, config, at from endpoint_history order by endpoint_id, version",
+        )
+        .all() as { endpoint_id: string; config: string; at: number }[];
+      let current = "";
+      let on: boolean | null = null;
+      let offAt = 0;
+      for (const row of history) {
+        const config = JSON.parse(row.config) as Endpoint;
+        if (row.endpoint_id !== current) {
+          current = row.endpoint_id;
+          on = null;
+        }
+        if (!config.enabled) {
+          if (on !== false) offAt = row.at;
+        } else if (on === false) {
+          const rows = this.db
+            .prepare(
+              "select id, type from events where merchant_id = ? and created >= ? and created <= ? order by created, rowid",
+            )
+            .all(config.merchant_id, offAt, row.at) as {
+            id: string;
+            type: string;
+          }[];
+          const ids = rows
+            .filter(
+              (e) =>
+                config.event_types.includes("*") ||
+                config.event_types.includes(e.type),
+            )
+            .map((e) => e.id);
+          if (ids.length > 0)
+            this.enqueue("endpoint.owed", now, {
+              endpoint_id: row.endpoint_id,
+              event_ids: ids,
+            });
+        }
+        on = config.enabled;
+      }
+    });
+  }
+
   summary(): Record<string, unknown> {
     const count = (sql: string) =>
       (this.db.prepare(sql).get() as { n: number }).n;
