+  // Once, at the first start of the release that repairs INC-2318: ask the router
+  // for the events that earlier switch-ons were owed and never got. The router
+  // skips what already has a delivery, so this is safe to repeat.
+  queueOwed(now: number): void {
+    this.transaction(() => {
+      const flag = this.db
+        .prepare("select value from meta where key = 'owed_queued'")
+        .get();
+      if (flag) return;
+      const history = this.db
+        .prepare(
+          "select endpoint_id, config, at from endpoint_history order by endpoint_id, version",
+        )
+        .all() as { endpoint_id: string; config: string; at: number }[];
+      let offAt: number | null = null;
+      let current = "";
+      let on = true;
+      for (const row of history) {
+        const config = JSON.parse(row.config) as Endpoint;
+        if (row.endpoint_id !== current) {
+          current = row.endpoint_id;
+          on = true;
+          offAt = null;
+        }
+        if (on && !config.enabled) {
+          offAt = row.at;
+        } else if (!on && config.enabled && offAt !== null) {
+          const types = config.event_types;
+          const events = this.db
+            .prepare(
+              "select id, type from events where merchant_id = ? and created >= ? and created < ? order by rowid",
+            )
+            .all(config.merchant_id, offAt, row.at) as {
+            id: string;
+            type: string;
+          }[];
+          for (const event of events) {
+            if (types.includes("*") || types.includes(event.type)) {
+              this.enqueue("resend.requested", now, {
+                event_id: event.id,
+                endpoint_id: current,
+                owed: true,
+              });
+            }
+          }
+        }
+        if (config.enabled) offAt = null;
+        on = config.enabled;
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('owed_queued', 1)")
+        .run();
+    });
+  }
+
   summary(): Record<string, unknown> {
     const count = (sql: string) =>
       (this.db.prepare(sql).get() as { n: number }).n;
