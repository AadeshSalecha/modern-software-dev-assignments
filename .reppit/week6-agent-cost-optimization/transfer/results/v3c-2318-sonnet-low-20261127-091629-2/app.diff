 const store = new Store(stateDir);
 const keys = new RecentKeys();
 
+// --- one-time repair (INC-2318) -------------------------------------------
+// Earlier releases dropped events owed to an endpoint switched back on. The outbox holds
+// every change and event in the order they happened; ask the router for what each
+// completed off period owed. The router skips whatever it already delivered.
+function requestOwed(): void {
+  store.transaction(() => {
+    const done = store.db
+      .prepare("select value from meta where key = 'owed_repair'")
+      .get();
+    if (done) return;
+    const rows = store.db
+      .prepare("select seq, type, at, data from outbox order by seq")
+      .all() as unknown as { seq: number; type: string; at: number; data: string }[];
+    const events: { merchant: string; type: string; id: string }[] = [];
+    const state = new Map<string, { enabled: boolean; from: number }>();
+    const owed: { endpoint: string; ids: string[] }[] = [];
+    for (const row of rows) {
+      const data = JSON.parse(row.data);
+      if (row.type === "event.accepted") {
+        events.push({ merchant: data.event.merchant_id, type: data.event.type, id: data.event.id });
+      } else if (row.type === "endpoint.changed") {
+        const ep = data.endpoint as Endpoint;
+        const prev = state.get(ep.id);
+        if (!ep.enabled && (!prev || prev.enabled)) {
+          state.set(ep.id, { enabled: false, from: events.length });
+        } else if (ep.enabled && prev && !prev.enabled) {
+          const ids = events
+            .slice(prev.from)
+            .filter(
+              (e) =>
+                e.merchant === ep.merchant_id &&
+                (ep.event_types.includes("*") || ep.event_types.includes(e.type)),
+            )
+            .map((e) => e.id);
+          if (ids.length) owed.push({ endpoint: ep.id, ids });
+          state.set(ep.id, { enabled: true, from: 0 });
+        } else if (!prev) {
+          state.set(ep.id, { enabled: ep.enabled, from: 0 });
+        }
+      }
+    }
+    for (const o of owed)
+      store.enqueue("catchup.requested", now(), { endpoint_id: o.endpoint, event_ids: o.ids });
+    store.db.prepare("insert into meta (key, value) values ('owed_repair', 1)").run();
+  });
+}
