+  // A switch-on (off -> on) is owed its merchant's events accepted after the
+  // change that switched it off (or its creation) and before the switch-on, of a
+  // type it is subscribed to at the switch-on. Order is the outbox sequence.
+  // Hands the owed events of switch-ons not yet handed over to the router, for
+  // endpoints that are on now (or only `only`). Call inside a transaction.
+  // `skipSeq`: a switch-on the router has just been told about in order.
+  backlog(only: string | null, skipSeq: number | null, at: number): void {
+    const rows = this.db
+      .prepare(
+        "select seq, type, data from outbox where type in ('event.accepted', 'endpoint.changed') order by seq",
+      )
+      .all() as unknown as { seq: number; type: string; data: string }[];
+    const state = new Map<string, { enabled: boolean; offSeq: number }>();
+    const byMerchant = new Map<string, { seq: number; id: string; type: string }[]>();
+    const current = new Map<string, Endpoint>();
+    const ons: { ep: Endpoint; offSeq: number; onSeq: number }[] = [];
+    for (const row of rows) {
+      const data = JSON.parse(row.data);
+      if (row.type === "event.accepted") {
+        const e = data.event;
+        const list = byMerchant.get(e.merchant_id) ?? [];
+        list.push({ seq: row.seq, id: e.id, type: e.type });
+        byMerchant.set(e.merchant_id, list);
+        continue;
+      }
+      const ep = data.endpoint as Endpoint;
+      const prev = state.get(ep.id);
+      if (!prev) {
+        state.set(ep.id, { enabled: ep.enabled, offSeq: row.seq });
+      } else if (prev.enabled && !ep.enabled) {
+        state.set(ep.id, { enabled: false, offSeq: row.seq });
+      } else if (!prev.enabled && ep.enabled) {
+        ons.push({ ep, offSeq: prev.offSeq, onSeq: row.seq });
+        state.set(ep.id, { enabled: true, offSeq: 0 });
+      }
+      current.set(ep.id, ep);
+    }
+    for (const on of ons) {
+      if (only !== null && on.ep.id !== only) continue;
+      if (!current.get(on.ep.id)?.enabled) continue;
+      const done = this.db
+        .prepare("select 1 from catchup_done where endpoint_id = ? and on_seq = ?")
+        .get(on.ep.id, on.onSeq);
+      if (done) continue;
+      if (on.onSeq !== skipSeq) {
+        const owed = (byMerchant.get(on.ep.merchant_id) ?? [])
+          .filter(
+            (e) =>
+              e.seq > on.offSeq &&
+              e.seq < on.onSeq &&
+              (on.ep.event_types.includes("*") || on.ep.event_types.includes(e.type)),
+          )
+          .map((e) => e.id);
+        if (owed.length > 0)
+          this.enqueue("catchup.requested", at, {
+            endpoint_id: on.ep.id,
+            event_ids: owed,
+          });
+      }
+      this.db
+        .prepare("insert into catchup_done (endpoint_id, on_seq) values (?, ?)")
+        .run(on.ep.id, on.onSeq);
+    }
+  }
