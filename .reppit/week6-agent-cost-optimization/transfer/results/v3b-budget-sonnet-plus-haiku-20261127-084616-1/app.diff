+  // One-time repair (2.3.2): earlier releases' router dropped endpoint changes as stale.
+  // Publish every endpoint's current configuration again, once per store.
+  resyncEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'endpoint_resync_1'")
+        .get();
+      if (done) return;
+      const rows = this.db.prepare("select id from endpoints order by id").all() as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        if (endpoint) this.enqueue("endpoint.changed", now, { endpoint });
+      }
+      this.db.prepare("insert into meta (key, value) values ('endpoint_resync_1', 1)").run();
+    });
+  }
+
