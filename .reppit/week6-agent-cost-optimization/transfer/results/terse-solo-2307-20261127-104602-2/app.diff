+  // The shipped release's router dropped resends it had no earlier delivery for. Once, hand the
+  // router the published requests per event and endpoint; it creates only what is missing.
+  replayLostResends(): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'resend_replay'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare(
+          "select data from outbox where type = 'resend.requested' and status in ('published', 'pending') order by seq",
+        )
+        .all() as { data: string }[];
+      const groups = new Map<string, { event_id: string; endpoint_id: string; requests: number }>();
+      for (const row of rows) {
+        const d = JSON.parse(row.data);
+        const key = `${d.event_id}\u0000${d.endpoint_id}`;
+        const g = groups.get(key) ?? { event_id: d.event_id, endpoint_id: d.endpoint_id, requests: 0 };
+        g.requests += 1;
+        groups.set(key, g);
+      }
+      this.db.exec("update outbox set status = 'published' where type = 'resend.requested' and status = 'pending'");
+      const at = Math.floor(Date.now() / 1000);
+      for (const g of groups.values()) this.enqueue("resend.requested", at, g);
+      this.db.prepare("insert into meta (key, value) values ('resend_replay', 1)").run();
+    });
   }
 
