+  // INC-2231: the router dropped endpoint changes as stale. Publish each endpoint's
+  // current state once; the marker and the messages commit together.
+  resyncEndpoints(): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'resync_2231'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as unknown as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        if (endpoint)
+          this.enqueue("endpoint.changed", Math.floor(Date.now() / 1000), {
+            endpoint,
+          });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('resync_2231', 1)")
+        .run();
+    });
   }
 
