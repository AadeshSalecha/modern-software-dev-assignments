+  // Release 2.4: endpoint changes the router dropped as stale are published again, once,
+  // as the current state of every endpoint. The marker makes later starts do nothing.
+  resyncEndpoints(now: number): number {
+    return this.transaction((): number => {
+      const marked = this.db
+        .prepare(
+          "insert into meta (key, value) values ('endpoint_resync_2_4', 1) on conflict (key) do nothing",
+        )
+        .run();
+      if (Number(marked.changes) !== 1) return 0;
+      const rows = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as unknown as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        if (endpoint) this.enqueue("endpoint.changed", now, { endpoint });
+      }
+      return rows.length;
+    });
+  }
