+  // One-time repair step (2.3.2): publish every endpoint's current state again so a
+  // router holding a wrong version for it converges. Done once per store.
+  reannounceEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'reannounce_2_3_2'")
+        .get();
+      if (done) return;
+      const ids = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as unknown as { id: string }[];
+      for (const { id } of ids) {
+        this.enqueue("endpoint.changed", now, { endpoint: this.endpoint(id) });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('reannounce_2_3_2', 1)")
+        .run();
+    });
+  }
