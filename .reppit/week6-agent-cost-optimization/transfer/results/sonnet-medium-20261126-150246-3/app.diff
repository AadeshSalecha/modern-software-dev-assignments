+// INC-2231: the router dropped endpoint changes as stale (a version-2 archive message had
+// inflated its version). Once per store, publish every endpoint's current state again.
+try {
+store.transaction(() => {
+  const done = store.db
+    .prepare("select value from meta where key = 'resync_endpoints_2231'")
+    .get();
+  if (done) return;
+  const rows = store.db
+    .prepare("select id from endpoints order by id")
+    .all() as unknown as { id: string }[];
+  for (const row of rows) {
+    const endpoint = store.endpoint(row.id);
+    if (endpoint) store.enqueue("endpoint.changed", now(), { endpoint });
+  }
+  store.db
+    .prepare("insert into meta (key, value) values ('resync_endpoints_2231', 1)")
+    .run();
+});
+} catch {
+  // another replica is doing it
+}
+
 server.listen(portBase + 1, "127.0.0.1", () =>
   log("api.started", { release: RELEASE }),
 );
