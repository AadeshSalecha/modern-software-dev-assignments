+  // Release 2.4: resends published by earlier releases may have produced no delivery.
+  // Publish each once more, naming the request; the router creates only what is missing.
+  replayResends(): void {
+    this.db.exec("begin immediate");
+    try {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'resend_replay'")
+        .get();
+      if (!done) {
+        const rows = this.db
+          .prepare(
+            "select seq, at, data from outbox where type = 'resend.requested' and status = 'published' and json_extract(data, '$.request') is null order by seq",
+          )
+          .all() as unknown as OutboxRow[];
+        for (const row of rows) {
+          const data = JSON.parse(row.data);
+          this.enqueue("resend.requested", row.at, { ...data, request: row.seq });
+        }
+        this.db.exec("insert into meta (key, value) values ('resend_replay', 1)");
+      }
+      this.db.exec("commit");
+    } catch (problem) {
+      this.db.exec("rollback");
+      throw problem;
+    }
   }
 
