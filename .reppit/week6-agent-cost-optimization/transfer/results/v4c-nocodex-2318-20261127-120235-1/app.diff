       .run(status, seq);
   }
 
+  // Once per store: tell the router what endpoints were owed by switch-ons the shipped
+  // release did not honour. Walks the outbox (every change and event, in order) and so
+  // needs nothing but what this store holds. A flag in the same transaction makes it
+  // a no-op on every later start.
+  backfillOwed(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'owed_backfill'")
+        .get();
+      if (done) return;
+      this.db
+        .prepare("insert into meta (key, value) values ('owed_backfill', 1)")
+        .run();
+      type Off = { merchant: string; events: { id: string; type: string }[] };
+      const state = new Map<string, boolean>(); // endpoint -> enabled
+      const off = new Map<string, Off>();
+      const closed = new Map<string, string[]>();
+      const rows = this.db
+        .prepare(
+          "select type, data from outbox where type in ('event.accepted', 'endpoint.changed') order by seq",
+        )
+        .all() as { type: string; data: string }[];
+      for (const row of rows) {
+        const data = JSON.parse(row.data);
+        if (row.type === "event.accepted") {
+          const ev = data.event as EventRecord;
+          for (const [id, period] of off) {
+            if (period.merchant === ev.merchant_id)
+              period.events.push({ id: ev.id, type: ev.type });
+          }
+          continue;
+        }
+        const ep = data.endpoint as Endpoint;
+        const was = state.get(ep.id);
+        state.set(ep.id, ep.enabled);
+        if (!ep.enabled && was !== false) {
+          off.set(ep.id, { merchant: ep.merchant_id, events: [] });
+        } else if (ep.enabled && was === false) {
+          const period = off.get(ep.id);
+          off.delete(ep.id);
+          if (!period) continue;
+          const types = ep.event_types;
+          const ids = period.events
+            .filter((e) => types.includes("*") || types.includes(e.type))
+            .map((e) => e.id);
+          closed.set(ep.id, [...(closed.get(ep.id) ?? []), ...ids]);
+        }
+      }
+      const all = new Set([...closed.keys(), ...off.keys()]);
+      for (const id of [...all].sort()) {
+        const events = [...new Set(closed.get(id) ?? [])];
+        const open = off.get(id)?.events.map((e) => e.id) ?? [];
+        if (events.length === 0 && open.length === 0) continue;
+        this.enqueue("endpoint.catchup", now, {
+          endpoint_id: id,
+          events,
+          open,
+        });
+      }
+    });
+  }
+
   summary(): Record<string, unknown> {
     const count = (sql: string) =>
       (this.db.prepare(sql).get() as { n: number }).n;
