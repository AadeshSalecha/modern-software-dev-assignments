+  // Once per store: queue again every resend the shipped release may have
+  // published without the router creating a delivery. The router tells the
+  // ones that already got a delivery apart and ignores them.
+  replayLostResends(): void {
+    this.db.exec("begin immediate");
+    try {
+      const done = this.db
+        .prepare("select value from meta where key = 'resend_replay'")
+        .get();
+      if (!done) {
+        const rows = this.db
+          .prepare(
+            "select seq, at, data from outbox where type = 'resend.requested' and status != 'rejected' order by seq",
+          )
+          .all() as unknown as { seq: number; at: number; data: string }[];
+        for (const row of rows) {
+          const data = JSON.parse(row.data);
+          if (data.request_seq !== undefined) continue;
+          this.enqueue("resend.requested", row.at, {
+            ...data,
+            request_seq: row.seq,
+            replay: true,
+          });
+        }
+        this.db.exec("insert into meta (key, value) values ('resend_replay', 1)");
+      }
+      this.db.exec("commit");
+    } catch (problem) {
+      this.db.exec("rollback");
+      throw problem;
+    }
   }
 
