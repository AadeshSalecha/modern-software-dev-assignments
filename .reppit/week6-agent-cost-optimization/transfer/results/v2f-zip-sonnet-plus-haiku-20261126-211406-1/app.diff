+def repair_v2_versions(db):
+    """One-time: version 2 messages used their sequence number as the endpoint version, which
+    left endpoints at a version no api change can reach. Such endpoints go back to version 0
+    (the api re-publishes its current endpoints once, which then apply)."""
+    cols = [r[1] for r in db.execute("pragma table_info(endpoints)")]
+    if "v2_seq" not in cols:
+        db.execute("alter table endpoints add column v2_seq integer")
+    if db.execute("select 1 from meta where key = 'v2_version_repair'").fetchone():
+        return
+    db.execute(
+        "update endpoints set v2_seq = version, version = 0 where version in "
+        "(select cast(ident as integer) from bus_seen where producer = 'api.v2') "
+        "and version > 0 and exists (select 1 from bus_seen where producer = 'api.v2' "
+        "and cast(ident as integer) = endpoints.version)"
+    )
+    db.execute("insert into meta (key, value) values ('v2_version_repair', 1)")
