+def migrate(db):
+    """INC-2231: version 2 endpoint messages used their sequence number as the endpoint version.
+    Mark such rows (src = 'v2') and drop the bogus version; safe to run on every start."""
+    cols = [r[1] for r in db.execute("pragma table_info(endpoints)")]
+    if "src" in cols:
+        return
+    db.execute("alter table endpoints add column src text not null default 'v3'")
+    db.execute("alter table endpoints add column v2_seq integer not null default 0")
+    db.execute(
+        "update endpoints set src = 'v2', v2_seq = version, version = 0 "
+        "where cast(version as text) in (select ident from bus_seen where producer = 'api.v2')"
+    )
+
