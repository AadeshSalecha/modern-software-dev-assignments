+  // INC-2231: the router dropped endpoint changes as stale. Publish every endpoint's current
+  // state once more, under new bus sequence numbers. Runs once per store (guarded by meta).
+  resyncEndpoints(now: number): number {
+    return this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'resync_inc2231'")
+        .get();
+      if (done) return 0;
+      this.db
+        .prepare("insert into meta (key, value) values ('resync_inc2231', 1)")
+        .run();
+      const rows = this.db.prepare("select id from endpoints order by id").all() as { id: string }[];
+      for (const row of rows) {
+        this.enqueue("endpoint.changed", now, { endpoint: this.endpoint(row.id) });
+      }
+      return rows.length;
+    });
+  }
+
