+// One-time repair (INC-2307): resends accepted by releases before 2.3.2 may have produced no
+// delivery. Tell the router how many requests exist per event and endpoint; it creates the
+// missing ones. The marker row makes this a no-op on every later start.
+function reconcileResends(): void {
+  store.transaction(() => {
+    store.db.exec(
+      "create table if not exists repairs (name text primary key)",
+    );
+    const done = store.db
+      .prepare("select 1 from repairs where name = 'resend.reconcile'")
+      .get();
+    if (done) return;
+    store.db
+      .prepare("insert into repairs (name) values ('resend.reconcile')")
+      .run();
+    const counts = new Map<string, { event_id: string; endpoint_id: string; requested: number }>();
+    const rows = store.db
+      .prepare(
+        "select data from outbox where type = 'resend.requested' and status != 'rejected' order by seq",
+      )
+      .all() as unknown as { data: string }[];
+    for (const row of rows) {
+      const d = JSON.parse(row.data);
+      const k = JSON.stringify([d.event_id, d.endpoint_id]);
+      const c = counts.get(k) ?? { event_id: d.event_id, endpoint_id: d.endpoint_id, requested: 0 };
+      c.requested += 1;
+      counts.set(k, c);
+    }
+    for (const c of counts.values())
+      store.enqueue("resend.reconcile", now(), c);
+  });
+}
+reconcileResends();
+
 // --- request handling -----------------------------------------------------
 
 type Reply = [number, unknown];
