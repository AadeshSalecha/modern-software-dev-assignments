+  // Once per store: tell the router the current state of every endpoint, so changes it
+  // dropped as stale under the shipped release take effect. Safe to run on every start.
+  resyncEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'endpoint_resync_1'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        if (endpoint) this.enqueue("endpoint.changed", now, { endpoint });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('endpoint_resync_1', 1)")
+        .run();
+    });
+  }
+
