+  // Once per store: publish every endpoint's current state again, so a router that holds
+  // versions the api never issued is corrected. Safe to call on every start.
+  resyncEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'endpoint_resync'")
+        .get();
+      if (done) return;
+      const ids = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as unknown as { id: string }[];
+      for (const { id } of ids) {
+        this.enqueue("endpoint.changed", now, { endpoint: this.endpoint(id) });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('endpoint_resync', 1)")
+        .run();
+    });
+  }
+
