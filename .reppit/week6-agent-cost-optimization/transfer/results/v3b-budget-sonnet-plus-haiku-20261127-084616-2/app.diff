+  // Once per store: publish every endpoint's current state again, so routers that
+  // dropped or mis-ordered earlier changes converge. Safe to run on every start.
+  resyncEndpoints(now: number): void {
+    this.db.exec("begin immediate");
+    try {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'endpoint_resync_1'")
+        .get();
+      if (!done) {
+        const ids = this.db
+          .prepare("select id from endpoints order by id")
+          .all() as { id: string }[];
+        for (const { id } of ids) {
+          const endpoint = this.endpoint(id);
+          if (endpoint) this.enqueue("endpoint.changed", now, { endpoint });
+        }
+        this.db
+          .prepare("insert into meta (key, value) values ('endpoint_resync_1', 1)")
+          .run();
+      }
+      this.db.exec("commit");
+    } catch (e) {
+      this.db.exec("rollback");
+      throw e;
+    }
+  }
+
