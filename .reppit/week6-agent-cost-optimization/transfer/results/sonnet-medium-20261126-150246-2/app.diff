+  // Once per store: send every endpoint's current state again. A router that dropped
+  // changes as stale (or holds an archive's numbering) takes them from here.
+  resyncEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'endpoint_resync'")
+        .get();
+      if (done) return;
+      this.db
+        .prepare("insert into meta (key, value) values ('endpoint_resync', 1)")
+        .run();
+      const rows = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        if (endpoint) this.enqueue("endpoint.changed", now, { endpoint });
+      }
+    });
+  }
+
