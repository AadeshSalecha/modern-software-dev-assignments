+  // Release 2.3.2: earlier releases' endpoint changes may have been dropped by the router
+  // (archive versions outranked them). Send every endpoint's current state once more.
+  resyncEndpoints(): void {
+    this.db.exec("begin immediate");
+    try {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'endpoint_resync_1'")
+        .get();
+      if (!done) {
+        const rows = this.db
+          .prepare("select id from endpoints order by id")
+          .all() as { id: string }[];
+        for (const r of rows) {
+          const row = this.db
+            .prepare("select updated_at from endpoints where id = ?")
+            .get(r.id) as { updated_at: number };
+          this.enqueue("endpoint.changed", Math.floor(Date.now() / 1000), {
+            endpoint: this.endpoint(r.id),
+          });
+          void row;
+        }
+        this.db
+          .prepare("insert into meta (key, value) values ('endpoint_resync_1', 1)")
+          .run();
+      }
+      this.db.exec("commit");
+    } catch (problem) {
+      this.db.exec("rollback");
+      throw problem;
+    }
   }
 
