+  // Once per store: queue the events that earlier switch-ons owed and never
+  // delivered (the router used to look back one day only). The router creates a
+  // delivery only where the endpoint has none for the event.
+  backfillCatchUp(): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = ?")
+        .get(CATCHUP_KEY);
+      if (done) return;
+      this.db
+        .prepare("insert into meta (key, value) values (?, 1)")
+        .run(CATCHUP_KEY);
+      const hist = this.db
+        .prepare(
+          "select endpoint_id, version, config, at from endpoint_history order by endpoint_id, version",
+        )
+        .all() as { endpoint_id: string; version: number; config: string; at: number }[];
+      const byEp = new Map<string, { config: Endpoint; at: number }[]>();
+      for (const h of hist) {
+        const list = byEp.get(h.endpoint_id) ?? [];
+        list.push({ config: JSON.parse(h.config), at: h.at });
+        byEp.set(h.endpoint_id, list);
+      }
+      const events = this.db
+        .prepare(
+          "select id, merchant_id, type, created from events order by rowid",
+        )
+        .all() as { id: string; merchant_id: string; type: string; created: number }[];
+      for (const [epId, list] of byEp) {
+        for (let i = 1; i < list.length; i++) {
+          if (!list[i].config.enabled || list[i - 1].config.enabled) continue;
+          let j = i - 1;
+          while (j > 0 && !list[j - 1].config.enabled) j--;
+          const from = list[j].at;
+          const to = list[i].at;
+          const types = list[i].config.event_types;
+          const merchant = list[i].config.merchant_id;
+          for (const e of events) {
+            if (e.merchant_id !== merchant) continue;
+            if (e.created < from || e.created >= to) continue;
+            if (!types.includes("*") && !types.includes(e.type)) continue;
+            this.enqueue("resend.requested", Math.max(to, e.created), {
+              event_id: e.id,
+              endpoint_id: epId,
+              catch_up: true,
+            });
+          }
+        }
+      }
+    });
+  }
+
