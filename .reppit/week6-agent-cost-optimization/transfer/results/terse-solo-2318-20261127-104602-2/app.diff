@@ -216,6 +216,62 @@
       .run(status, seq);
   }
 
+  // Earlier releases lost the events an endpoint missed while it was off whenever
+  // the off period was longer than a day. Work out, from the endpoint history, the
+  // events owed at each past switch-on and hand them to the router (which skips
+  // whatever it already delivered). Done once per store.
+  backfill(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'owed_backfill'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare(
+          "select endpoint_id, config, at from endpoint_history order by endpoint_id, version",
+        )
+        .all() as unknown as { endpoint_id: string; config: string; at: number }[];
+      let prevId = "";
+      let prev: boolean | undefined;
+      let offAt = 0;
+      for (const row of rows) {
+        const cfg = JSON.parse(row.config) as Endpoint;
+        if (row.endpoint_id !== prevId) {
+          prevId = row.endpoint_id;
+          prev = undefined;
+        }
+        if (!cfg.enabled && prev !== false) offAt = row.at;
+        if (cfg.enabled && prev === false) {
+          const owed = (
+            this.db
+              .prepare(
+                "select id, type from events where merchant_id = ? and created >= ? and created < ? order by rowid",
+              )
+              .all(cfg.merchant_id, offAt, row.at) as unknown as {
+              id: string;
+              type: string;
+            }[]
+          )
+            .filter(
+              (e) =>
+                cfg.event_types.includes("*") ||
+                cfg.event_types.includes(e.type),
+            )
+            .map((e) => e.id);
+          if (owed.length > 0)
+            this.enqueue("endpoint.backfill", now, {
+              endpoint_id: cfg.id,
+              event_ids: owed,
+            });
+        }
+        prev = cfg.enabled;
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('owed_backfill', 1)")
+        .run();
+    });
+  }
+
   summary(): Record<string, unknown> {
     const count = (sql: string) =>
       (this.db.prepare(sql).get() as { n: number }).n;
