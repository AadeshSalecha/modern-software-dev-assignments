+  // Resends the shipped release published may have been dropped by the router. Publish them
+  // again once, with how many later requests the same pair has; the router tells which it
+  // already served. Old rows become 'replayed', so a second start does nothing.
+  replayResends(): void {
+    this.transaction(() => {
+      if (this.db.prepare("select 1 from meta where key = 'resends_replayed'").get())
+        return;
+      this.db
+        .prepare("insert into meta (key, value) values ('resends_replayed', 1)")
+        .run();
+      const rows = this.db
+        .prepare(
+          "select seq, at, data from outbox where type = 'resend.requested' and status = 'published' order by seq",
+        )
+        .all() as unknown as { seq: number; at: number; data: string }[];
+      const seen = new Map<string, number>();
+      for (let i = rows.length - 1; i >= 0; i--) {
+        const d = JSON.parse(rows[i].data);
+        const key = `${d.event_id}\u0000${d.endpoint_id}`;
+        const later = seen.get(key) ?? 0;
+        seen.set(key, later + 1);
+        this.enqueue("resend.requested", rows[i].at, {
+          event_id: d.event_id,
+          endpoint_id: d.endpoint_id,
+          legacy_later: later,
+        });
+      }
+      this.db
+        .prepare(
+          "update outbox set status = 'replayed' where type = 'resend.requested' and status = 'published'",
+        )
+        .run();
+    });
+  }
+
