+  // INC-2231: the router may have dropped endpoint changes as stale. Once per store,
+  // tell it every endpoint's current configuration again, under new sequence numbers.
+  republishEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'republish_2231'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as { id: string }[];
+      for (const row of rows) this.enqueue("endpoint.changed", now, { endpoint: this.endpoint(row.id) });
+      this.db
+        .prepare("insert into meta (key, value) values ('republish_2231', 1)")
+        .run();
+    });
+  }
+
