+  // Once per store: events an endpoint was owed at an earlier switch-on that the
+  // shipped release never delivered. The outbox is the exact order of what was
+  // accepted and changed; replay it and ask the router to deliver the owed events
+  // (the router skips any that already have a delivery).
+  repairMissed(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'catchup_repair'")
+        .get();
+      if (done) return;
+      this.db
+        .prepare("insert into meta (key, value) values ('catchup_repair', 1)")
+        .run();
+      const rows = this.db
+        .prepare(
+          "select type, at, data from outbox where type in ('event.accepted','endpoint.changed') order by seq",
+        )
+        .all() as unknown as { type: string; at: number; data: string }[];
+      const state = new Map<
+        string,
+        { merchant: string; enabled: boolean; owed: string[] }
+      >();
+      const requests: { at: number; endpoint: string; ids: string[] }[] = [];
+      for (const row of rows) {
+        const data = JSON.parse(row.data);
+        if (row.type === "event.accepted") {
+          const ev = data.event;
+          for (const [, st] of state) {
+            if (st.merchant === ev.merchant_id && !st.enabled) {
+              st.owed.push(ev.id + "|" + ev.type);
+            }
+          }
+        } else {
+          const ep = data.endpoint as Endpoint;
+          const st = state.get(ep.id);
+          if (!st) {
+            state.set(ep.id, {
+              merchant: ep.merchant_id,
+              enabled: ep.enabled,
+              owed: [],
+            });
+          } else {
+            if (!st.enabled && ep.enabled) {
+              const ids = st.owed
+                .map((x) => x.split("|"))
+                .filter(
+                  ([, t]) =>
+                    ep.event_types.includes("*") || ep.event_types.includes(t),
+                )
+                .map(([i]) => i);
+              if (ids.length) requests.push({ at: row.at, endpoint: ep.id, ids });
+              st.owed = [];
+            } else if (st.enabled && !ep.enabled) {
+              st.owed = [];
+            }
+            st.enabled = ep.enabled;
+          }
+        }
+      }
+      const at = now;
+      for (const r of requests) {
+        this.enqueue("catchup.requested", at, {
+          endpoint_id: r.endpoint,
+          event_ids: r.ids,
+        });
+      }
+    });
+  }
+
