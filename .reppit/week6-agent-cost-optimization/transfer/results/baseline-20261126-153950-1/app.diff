@@ -0,0 +1,80 @@
+"""Endpoint changes from the api (version 3) and from the archive (version 2)."""
+
+import unittest
+
+import bus
+import routing
+from helpers import Harness
+
+
+def v2(seq, active=True, url="http://127.0.0.1:9/archive", secret="whsec_b2xk"):
+    return {
+        "v": 2, "seq": seq, "kind": "endpoint",
+        "endpoint": {"id": "ep_a", "merchant": "m_acme", "url": url, "secret": secret, "types": ["*"], "active": active},
+    }  # fmt: skip
+
+
+def v3(seq, version, enabled=True, url="http://127.0.0.1:9/api", secret="whsec_bmV3"):
+    return {
+        "v": 3, "producer": "api", "seq": seq, "type": "endpoint.changed", "at": 1793577600,
+        "data": {"endpoint": {
+            "id": "ep_a", "merchant_id": "m_acme", "url": url, "secret": secret,
+            "event_types": ["*"], "enabled": enabled, "version": version,
+        }},
+    }  # fmt: skip
+
+
+class EndpointOrderTest(unittest.TestCase):
+    def setUp(self):
+        self.r = Harness()
+        self.addCleanup(self.r.close)
+
+    def send(self, msg):
+        _, _, kind, body = bus.parse(msg)
+        routing.apply(self.r.db, self.r.log, self.r.now(), kind, body)
+        self.r.db.commit()
+
+    def row(self):
+        return self.r.db.execute("select * from endpoints where id = 'ep_a'").fetchone()
+
+    def test_api_changes_win_over_an_archive_sequence_number_that_looks_newer(self):
+        self.send(v2(4117))
+        self.send(v3(1, 2, enabled=False))
+        self.assertEqual((self.row()["enabled"], self.row()["version"]), (0, 2))
+        self.send(v3(2, 3, url="http://127.0.0.1:9/moved"))
+        self.assertEqual((self.row()["enabled"], self.row()["url"]), (1, "http://127.0.0.1:9/moved"))
+
+    def test_a_replayed_archive_message_does_not_undo_an_api_change(self):
+        self.send(v3(1, 2, enabled=False))
+        self.send(v2(4117))
+        self.send(v2(5302))
+        self.assertEqual((self.row()["enabled"], self.row()["version"]), (0, 2))
+        self.assertEqual(self.r.db.execute("select url from endpoints").fetchone()[0], "http://127.0.0.1:9/api")
+
+    def test_archive_messages_are_ordered_by_their_sequence_numbers(self):
+        self.send(v2(7, url="http://127.0.0.1:9/seven"))
+        self.send(v2(5, url="http://127.0.0.1:9/five"))
+        self.assertEqual(self.row()["url"], "http://127.0.0.1:9/seven")
+        self.send(v2(9, active=False))
+        self.assertEqual(self.row()["enabled"], 0)
+
+    def test_api_versions_are_ordered_by_version_not_arrival(self):
+        self.send(v3(1, 3, url="http://127.0.0.1:9/three"))
+        self.send(v3(2, 2, url="http://127.0.0.1:9/two"))
