+// One-time repair (INC-2307): resend requests accepted by the shipped release were
+// dropped by the router when the endpoint had no earlier delivery. Tell the router which
+// requests exist, once per event and endpoint; it creates the deliveries that are missing.
+function reconcileResends(): void {
+  store.transaction(() => {
+    const done = store.db
+      .prepare("select value from meta where key = 'resend_reconcile'")
+      .get();
+    if (done) return;
+    const rows = store.db
+      .prepare(
+        "select seq, data from outbox where type = 'resend.requested' and status != 'rejected' order by seq",
+      )
+      .all() as unknown as { seq: number; data: string }[];
+    const pairs = new Map<string, { data: Record<string, unknown>; seqs: number[] }>();
+    for (const row of rows) {
+      const data = JSON.parse(row.data);
+      const key = JSON.stringify([data.event_id, data.endpoint_id]);
+      const entry = pairs.get(key) ?? { data, seqs: [] };
+      entry.seqs.push(row.seq);
+      pairs.set(key, entry);
+    }
+    for (const { data, seqs } of pairs.values()) {
+      store.enqueue("resend.requested", now(), {
+        event_id: data.event_id,
+        endpoint_id: data.endpoint_id,
+        legacy_seqs: seqs,
+      });
+    }
+    store.db
+      .prepare("insert into meta (key, value) values ('resend_reconcile', 1)")
+      .run();
+  });
+}
+reconcileResends();
+
 server.listen(portBase + 1, "127.0.0.1", () =>
   log("api.started", { release: RELEASE }),
 );
