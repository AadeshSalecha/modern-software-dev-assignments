+def migrate_2231(db):
+    """Archive (v2) messages used to set an endpoint's version to their sequence number,
+    which made later real changes look stale. Such rows go back to version 0 so the api's
+    next message for them applies. Runs once."""
+    if db.execute("select 1 from meta where key = 'v2_versions_2231'").fetchone():
+        return
+    db.execute(
+        "update endpoints set v2_seq = version, version = 0 where exists "
+        "(select 1 from bus_seen where producer = 'api.v2' and ident = cast(endpoints.version as text))"
+    )
+    db.execute("insert into meta (key, value) values ('v2_versions_2231', 1)")
