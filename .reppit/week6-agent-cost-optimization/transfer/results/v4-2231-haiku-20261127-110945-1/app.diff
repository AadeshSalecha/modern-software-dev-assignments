+  // One-time (INC-2231): the router may hold endpoint state corrupted by archive
+  // messages; send every endpoint's current state again. Safe to repeat: flag-guarded.
+  republishEndpoints(): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'republish_2231'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as { id: string }[];
+      for (const r of rows) {
+        const endpoint = this.endpoint(r.id);
+        const at = (
+          this.db
+            .prepare("select updated_at as a from endpoints where id = ?")
+            .get(r.id) as { a: number }
+        ).a;
+        this.enqueue("endpoint.changed", at, { endpoint });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('republish_2231', 1)")
+        .run();
+    });
   }
 
