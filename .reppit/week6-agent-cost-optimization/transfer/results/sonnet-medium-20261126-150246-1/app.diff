+  republishEndpoints(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'republish_2231'")
+        .get();
+      if (done) return;
+      const ids = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as { id: string }[];
+      for (const { id } of ids) {
+        this.enqueue("endpoint.changed", now, { endpoint: this.endpoint(id) });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('republish_2231', 1)")
+        .run();
+    });
