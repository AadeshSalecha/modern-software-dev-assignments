+  // Start-up step, run once per store (marked in meta): for every switch-on the
+  // outbox records, tell the router which events of the off period are owed, so
+  // that the ones an earlier release never delivered still go out.
+  // Safe to run again: the meta mark and the enqueues share one transaction.
+  backfillOwed(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'owed_backfill'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare(
+          "select seq, type, data from outbox where type in ('endpoint.changed', 'event.accepted') order by seq",
+        )
+        .all() as unknown as { seq: number; type: string; data: string }[];
+      const state = new Map<string, { enabled: boolean; start: number }>();
+      const owed = new Map<string, Set<string>>();
+      const events: { seq: number; id: string; merchant: string; type: string }[] = [];
+      for (const row of rows) {
+        const data = JSON.parse(row.data);
+        if (row.type === "event.accepted") {
+          const e = data.event;
+          events.push({ seq: row.seq, id: e.id, merchant: e.merchant_id, type: e.type });
+          continue;
+        }
+        const ep = data.endpoint as Endpoint;
+        const before = state.get(ep.id);
+        if (!before) {
+          state.set(ep.id, { enabled: ep.enabled, start: row.seq });
+        } else if (before.enabled && !ep.enabled) {
+          state.set(ep.id, { enabled: false, start: row.seq });
+        } else if (!before.enabled && ep.enabled) {
+          const set = owed.get(ep.id) ?? new Set<string>();
+          for (const e of events) {
+            if (e.merchant !== ep.merchant_id || e.seq <= before.start) continue;
+            if (ep.event_types.includes("*") || ep.event_types.includes(e.type))
+              set.add(e.id);
+          }
+          owed.set(ep.id, set);
+          state.set(ep.id, { enabled: true, start: row.seq });
+        }
+      }
+      for (const [id, ids] of owed) {
+        if (ids.size === 0) continue;
+        const current = this.endpoint(id);
+        if (!current) continue;
+        this.enqueue("endpoint.changed", now, {
+          endpoint: current,
+          owed: [...ids],
+        });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('owed_backfill', 1)")
+        .run();
+    });
+  }
+
