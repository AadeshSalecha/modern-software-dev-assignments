+  // One-time step for resends the shipped release accepted: it dropped some of them in the
+  // router without a trace. Tell the router, per event and endpoint, which requests exist so
+  // it can create the deliveries that are missing. Runs once per store (marker in meta).
+  reconcileResends(now: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'resend_reconcile'")
+        .get();
+      if (done) return;
+      this.db
+        .prepare("insert into meta (key, value) values ('resend_reconcile', 1)")
+        .run();
+      const rows = this.db
+        .prepare(
+          "select seq, data from outbox where type = 'resend.requested' and status != 'rejected' order by seq",
+        )
+        .all() as unknown as { seq: number; data: string }[];
+      const pairs = new Map<string, { event_id: string; endpoint_id: string; covers: number[] }>();
+      for (const row of rows) {
+        const body = JSON.parse(row.data);
+        const event = this.event(body.event_id);
+        const endpoint = this.endpoint(body.endpoint_id);
+        if (!event || !endpoint || event.merchant_id !== endpoint.merchant_id) continue;
+        const key = `${body.event_id}\u0000${body.endpoint_id}`;
+        const pair = pairs.get(key) ?? {
+          event_id: body.event_id,
+          endpoint_id: body.endpoint_id,
+          covers: [],
+        };
+        pair.covers.push(row.seq);
+        pairs.set(key, pair);
+      }
+      for (const pair of pairs.values()) this.enqueue("resend.reconcile", now, pair);
+    });
+  }
