+  // Resends the shipped release published were applied by a router that dropped some of
+  // them. Tell the router, once, how many requests each event and endpoint had; it
+  // creates what is missing. Rows are flagged legacy = 1 (done) or 0 (new code's).
+  reconcileResends(): void {
+    const cols = this.db.prepare("pragma table_info(outbox)").all() as unknown as {
+      name: string;
+    }[];
+    if (!cols.some((c) => c.name === "legacy"))
+      this.db.exec("alter table outbox add column legacy integer");
+    this.transaction(() => {
+      const rows = this.db
+        .prepare(
+          "select seq, status, data, type, at from outbox where legacy is null and type = 'resend.requested' and status in ('published', 'pending')",
+        )
+        .all() as unknown as { seq: number; data: string; at: number }[];
+      const counts = new Map<string, { event_id: string; endpoint_id: string; requests: number; at: number }>();
+      for (const r of rows) {
+        const d = JSON.parse(r.data);
+        const k = `${d.event_id}\u0000${d.endpoint_id}`;
+        const c = counts.get(k) ?? { event_id: d.event_id, endpoint_id: d.endpoint_id, requests: 0, at: r.at };
+        c.requests += 1;
+        counts.set(k, c);
+      }
+      for (const c of counts.values())
+        this.enqueue("resend.reconcile", c.at, c);
+      this.db.exec("update outbox set legacy = 1, status = 'published' where legacy is null and type = 'resend.requested' and status in ('published', 'pending')");
+      this.db.exec("update outbox set legacy = 0 where legacy is null");
