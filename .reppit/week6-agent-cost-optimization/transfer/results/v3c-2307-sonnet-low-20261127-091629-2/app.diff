+  // One-time, safe to repeat: resends the shipped release accepted were applied by the router
+  // only when the event had gone to that endpoint before. Fold every earlier request into one
+  // message per event and endpoint carrying how many were made; the router creates what is missing.
+  reconcileResends(): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'resend_reconcile'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare(
+          "select seq, status, data from outbox where type = 'resend.requested' and status != 'rejected' order by seq",
+        )
+        .all() as unknown as { seq: number; status: string; data: string }[];
+      const pairs = new Map<string, { event_id: string; endpoint_id: string; n: number }>();
+      for (const r of rows) {
+        const d = JSON.parse(r.data);
+        const k = JSON.stringify([d.event_id, d.endpoint_id]);
+        const p = pairs.get(k) ?? { event_id: d.event_id, endpoint_id: d.endpoint_id, n: 0 };
+        p.n += 1;
+        pairs.set(k, p);
+      }
+      for (const p of pairs.values())
+        this.enqueue("resend.requested", Math.floor(Date.now() / 1000), {
+          event_id: p.event_id,
+          endpoint_id: p.endpoint_id,
+          reconcile: p.n,
+        });
+      this.db
+        .prepare(
+          "update outbox set status = 'published' where type = 'resend.requested' and status = 'pending' and data not like '%reconcile%'",
+        )
+        .run();
+      this.db.prepare("insert into meta (key, value) values ('resend_reconcile', 1)").run();
+    });
   }
 
