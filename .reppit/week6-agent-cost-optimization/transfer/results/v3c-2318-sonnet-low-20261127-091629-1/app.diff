+  // INC-2318: once, queue for the router the events each completed off period
+  // owed its endpoint. Replays the outbox, whose order is the order of acceptance.
+  queueOwedCatchUp(): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select value from meta where key = 'catchup_2318'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare(
+          "select type, data from outbox where type in ('event.accepted', 'endpoint.changed') order by seq",
+        )
+        .all() as unknown as { type: string; data: string }[];
+      const events: Record<string, { id: string; type: string }[]> = {};
+      const state: Record<string, { enabled: boolean; from: number }> = {};
+      const owed: { endpoint_id: string; event_ids: string[] }[] = [];
+      for (const row of rows) {
+        const data = JSON.parse(row.data);
+        if (row.type === "event.accepted") {
+          const e = data.event as EventRecord;
+          (events[e.merchant_id] ??= []).push({ id: e.id, type: e.type });
+          continue;
+        }
+        const ep = data.endpoint as Endpoint;
+        const list = (events[ep.merchant_id] ??= []);
+        const prev = state[ep.id];
+        if (!ep.enabled && (!prev || prev.enabled)) {
+          state[ep.id] = { enabled: false, from: list.length };
+        } else if (ep.enabled && prev && !prev.enabled) {
+          const ids = list
+            .slice(prev.from)
+            .filter((e) => ep.event_types.includes("*") || ep.event_types.includes(e.type))
+            .map((e) => e.id);
+          if (ids.length > 0) owed.push({ endpoint_id: ep.id, event_ids: ids });
+          state[ep.id] = { enabled: true, from: list.length };
+        } else if (!prev) {
+          state[ep.id] = { enabled: ep.enabled, from: list.length };
+        }
+      }
+      for (const item of owed) this.enqueue("catchup.requested", Math.floor(Date.now() / 1000), item);
+      this.db
+        .prepare("insert into meta (key, value) values ('catchup_2318', 1)")
+        .run();
+    });
+  }
+
   summary(): Record<string, unknown> {
