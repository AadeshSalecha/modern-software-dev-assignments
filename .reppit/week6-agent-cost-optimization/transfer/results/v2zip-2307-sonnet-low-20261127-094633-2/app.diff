+
+  // Once per store: resends the shipped release published were skipped by the
+  // router when the event had never been sent to the endpoint. Ask the router
+  // to make up the difference. Resends still pending go out normally.
+  recoverResends(): void {
+    this.db.exec("begin immediate");
+    try {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'resend_recover'")
+        .get();
+      if (!done) {
+        const rows = this.db
+          .prepare(
+            "select seq, data from outbox where type = 'resend.requested' and status != 'rejected' order by seq",
+          )
+          .all() as { seq: number; data: string }[];
+        const counts = new Map<string, { event_id: string; endpoint_id: string; seqs: number[] }>();
+        for (const r of rows) {
+          const d = JSON.parse(r.data);
+          const k = d.event_id + "\u0000" + d.endpoint_id;
+          const c = counts.get(k) ?? { event_id: d.event_id, endpoint_id: d.endpoint_id, seqs: [] };
+          c.seqs.push(r.seq);
+          counts.set(k, c);
+        }
+        const at = Math.floor(Date.now() / 1000);
+        for (const c of counts.values()) this.enqueue("resend.recover", at, c);
+        this.db.prepare("insert into meta (key, value) values ('resend_recover', 1)").run();
+      }
+      this.db.exec("commit");
+    } catch (problem) {
+      this.db.exec("rollback");
+      throw problem;
+    }
   }
 
