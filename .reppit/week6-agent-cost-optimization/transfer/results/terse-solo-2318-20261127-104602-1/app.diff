+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare(
+          `select h.endpoint_id, h.version, h.config, h.at from endpoint_history h
+           where h.endpoint_id in (
+             select a.endpoint_id from endpoint_history a join endpoint_history b
+               on b.endpoint_id = a.endpoint_id and b.version = a.version - 1
+             where json_extract(a.config, '$.enabled') = 1 and json_extract(b.config, '$.enabled') = 0)
+           order by h.at, h.endpoint_id, h.version`,
+        )
+        .all() as unknown as {
+        config: string;
+        at: number;
+      }[];
+      for (const row of rows)
+        this.enqueue("endpoint.changed", row.at, {
+          endpoint: JSON.parse(row.config),
+        });
+      this.db
+        .prepare("insert into meta (key, value) values ('history_replayed', 1)")
+        .run();
+    });
+  }
