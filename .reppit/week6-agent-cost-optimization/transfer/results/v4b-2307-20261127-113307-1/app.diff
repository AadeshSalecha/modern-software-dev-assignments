+def apply_reconcile(db, log, now, body):
+    """Give the resends the shipped release accepted but did not deliver their delivery, once.
+
+    Requests the shipped release applied have a bus_seen row but no delivery carrying their ident.
+    Those that did get a delivery are the pair's resend deliveries without an ident.
+    """
+    pending = {}
+    for req in sorted(body["requests"], key=lambda r: r["seq"]):
