+// Release 2.3.1 accepted resends its router did not turn into deliveries. Once per store, tell
+// the router which resend requests exist so it can deliver the ones it dropped.
+function reconcileResends(): void {
+  const db = store.db;
+  db.exec("begin immediate");
+  try {
+    const done = db
+      .prepare("select value from meta where key = 'resend_reconcile'")
+      .get();
+    if (!done) {
+      const rows = db
+        .prepare(
+          "select seq, data from outbox where type = 'resend.requested' and status != 'rejected' order by seq",
+        )
+        .all() as unknown as { seq: number; data: string }[];
+      if (rows.length > 0) {
+        store.enqueue("resend.reconcile", now(), {
+          requests: rows.map((row) => {
+            const data = JSON.parse(row.data);
+            return {
+              seq: row.seq,
+              event_id: data.event_id,
+              endpoint_id: data.endpoint_id,
+            };
+          }),
+        });
+      }
+      db.prepare("insert into meta (key, value) values ('resend_reconcile', 1)").run();
+    }
+    db.exec("commit");
+  } catch (problem) {
+    db.exec("rollback");
+    throw problem;
+  }
+}
+reconcileResends();
+
 server.listen(portBase + 1, "127.0.0.1", () =>
   log("api.started", { release: RELEASE }),
 );
