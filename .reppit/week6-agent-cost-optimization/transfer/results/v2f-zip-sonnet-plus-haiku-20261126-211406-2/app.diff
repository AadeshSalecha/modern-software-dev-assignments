+  // INC-2231: the router dropped endpoint changes as stale after archive
+  // messages inflated its versions. Once per store, send every endpoint's
+  // current configuration again; the router applies it idempotently.
+  republishEndpoints(at: number): void {
+    this.transaction(() => {
+      const done = this.db
+        .prepare("select 1 from meta where key = 'inc2231_republish'")
+        .get();
+      if (done) return;
+      const rows = this.db
+        .prepare("select id from endpoints order by id")
+        .all() as unknown as { id: string }[];
+      for (const row of rows) {
+        const endpoint = this.endpoint(row.id);
+        if (endpoint) this.enqueue("endpoint.changed", at, { endpoint });
+      }
+      this.db
+        .prepare("insert into meta (key, value) values ('inc2231_republish', 1)")
+        .run();
+    });
+  }
+
