+// Release 2.4: a store written by an earlier release holds off periods whose
+// events were never delivered. Ask the router, once, to catch each one up.
+function repairCatchUp(): void {
+  store.transaction(() => {
+    const done = store.db
+      .prepare("select value from meta where key = 'catchup_repair'")
+      .get();
+    if (done) return;
+    for (const period of store.switchOns()) {
+      store.enqueue("endpoint.catchup", now(), {
+        endpoint: period.endpoint,
+        from: period.from,
+        to: period.to,
+      });
+    }
+    store.db
+      .prepare("insert into meta (key, value) values ('catchup_repair', 1)")
+      .run();
+  });
+}
+repairCatchUp();
