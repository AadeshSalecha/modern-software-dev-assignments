+  // Start of the off period that the switch-on at `version` ends: the change
+  // that took the endpoint from on to off (its creation if created off). A
+  // change made while it is off does not move the start.
+  offStart(endpointId: string, version: number): number | null {
+    const rows = this.db
+      .prepare(
+        "select version, config, at from endpoint_history where endpoint_id = ? and version < ? order by version",
+      )
+      .all(endpointId, version) as { version: number; config: string; at: number }[];
+    let start: number | null = null;
+    for (const row of rows) {
+      const on = JSON.parse(row.config).enabled === true;
+      if (on) start = null;
+      else if (start === null) start = row.at;
+    }
+    return start;
+  }
+
+  // Every completed off period, as the switch-on that ended it.
+  switchOns(): { endpoint: Endpoint; from: number; to: number }[] {
+    const rows = this.db
+      .prepare(
+        "select endpoint_id, version, config, at from endpoint_history order by endpoint_id, version",
+      )
+      .all() as { endpoint_id: string; version: number; config: string; at: number }[];
+    const found: { endpoint: Endpoint; from: number; to: number }[] = [];
+    let current = "";
+    let start: number | null = null;
+    for (const row of rows) {
+      if (row.endpoint_id !== current) {
+        current = row.endpoint_id;
+        start = null;
+      }
+      const config = JSON.parse(row.config) as Endpoint;
+      if (config.enabled === true) {
+        if (start !== null) found.push({ endpoint: config, from: start, to: row.at });
+        start = null;
+      } else if (start === null) start = row.at;
+    }
+    return found;
+  }
+
