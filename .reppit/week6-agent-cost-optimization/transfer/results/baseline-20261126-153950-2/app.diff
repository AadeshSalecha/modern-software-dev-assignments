+def migrate(db):
+    """Bring a database written by an older release up to date.
+
+    api_version is the endpoint version assigned by the api (version 3 messages); 0 means
+    the api has not said anything about the endpoint. Earlier releases compared the
+    version-2 sequence numbers carried by archived messages with api versions, so the
+    version stored for an endpoint touched by the archive cannot be trusted. Rows from
+    those releases get api_version 0 and are overwritten by the next version 3 message
+    for the endpoint (the api republishes every endpoint on its first start after the fix).
+    """
+    columns = {row[1] for row in db.execute("pragma table_info(endpoints)")}
+    if "api_version" not in columns:
+        db.execute("alter table endpoints add column api_version integer not null default 0")
+
