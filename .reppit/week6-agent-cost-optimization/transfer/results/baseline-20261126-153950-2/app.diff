+  // Publish every endpoint's current configuration again, once per release
+  // (`marker`). Earlier releases had routers that dropped endpoint changes
+  // (INC-2231); a router row written by those releases is replaced by the next
+  // message from the api for that endpoint.
+  // Call inside a transaction. Returns the number of endpoints published.
+  resyncEndpoints(marker: string, now: number): number {
+    const done = this.db
+      .prepare("select 1 from meta where key = ?")
+      .get(marker);
+    if (done) return 0;
+    this.db.prepare("insert into meta (key, value) values (?, 1)").run(marker);
+    const all = this.endpoints();
+    for (const endpoint of all) this.enqueue("endpoint.changed", now, { endpoint });
+    return all.length;
+  }
