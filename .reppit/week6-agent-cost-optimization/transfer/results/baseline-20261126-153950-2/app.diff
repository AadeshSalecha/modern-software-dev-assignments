+def is_stale(old, endpoint):
+    """Whether a message about an endpoint is older than what the router already has.
+
+    The api numbers its own endpoint changes (version 3 messages). That numbering is
+    authoritative: once the api has spoken for an endpoint, archived version 2 messages,
+    whose sequence numbers are a different numbering, cannot change it. Version 2 messages
+    order among themselves, and only for endpoints the api has not spoken for.
+    """
+    if old is None:
+        return False
+    api_version = old["api_version"]
+    if endpoint.get("source", "api") == "v2":
+        if api_version > 0:
+            return True
+        return endpoint["version"] <= old["version"]
+    return endpoint["version"] <= api_version
+
