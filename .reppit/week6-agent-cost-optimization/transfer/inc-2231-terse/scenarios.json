[
 [
  "incident",
  {
   "name": "an endpoint switched off through the api gets nothing more, after an archive message for it",
   "steps": [
    {
     "at": 0,
     "do": "endpoint.create",
     "id": "ep_a",
     "merchant": "m_acme"
    },
    {
     "at": 1,
     "do": "drain"
    },
    {
     "at": 10,
     "do": "bus",
     "message": {
      "v": 2,
      "seq": 4100,
      "kind": "endpoint",
      "endpoint": {
       "id": "ep_a",
       "merchant": "m_acme",
       "url": "{receiver}/hooks/ep_a",
       "secret": "whsec_Lf0hjvpA9Yjr9SGd+mVfJKRb0vf11fJE",
       "types": [
        "*"
       ],
       "active": true
      }
     }
    },
    {
     "at": 20,
     "do": "endpoint.update",
     "id": "ep_a",
     "enabled": false
    },
    {
     "at": 21,
     "do": "drain"
    },
    {
     "at": 60,
     "do": "event",
     "ref": "e1",
     "merchant": "m_acme",
     "type": "payment.captured",
     "amount_minor": 1250,
     "currency": "USD"
    },
    {
     "at": 61,
     "do": "drain"
    }
   ],
   "expect": [
    {
     "endpoint": "ep_a",
     "requests": 0
    }
   ]
  }
 ],
