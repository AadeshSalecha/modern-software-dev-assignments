 [
  "regressions",
  {
   "name": "an older change that arrives late does not undo a newer one",
   "steps": [
    {
     "at": 0,
     "do": "endpoint.create",
     "id": "ep_a",
     "merchant": "m_acme"
    },
    {
     "at": 1,
     "do": "drain"
    },
    {
     "at": 20,
     "do": "bus",
     "ref": "newer",
     "message": {
      "v": 3,
      "producer": "api",
      "seq": 9001,
      "type": "endpoint.changed",
      "at": 1793577620,
      "data": {
       "endpoint": {
        "id": "ep_a",
        "merchant_id": "m_acme",
        "url": "{receiver}/hooks/ep_a",
        "secret": "whsec_Lf0hjvpA9Yjr9SGd+mVfJKRb0vf11fJE",
        "event_types": [
         "*"
        ],
        "enabled": false,
        "version": 5
       }
      }
     }
    },
    {
     "at": 21,
     "do": "bus",
     "ref": "older",
     "message": {
      "v": 3,
      "producer": "api",
      "seq": 9000,
      "type": "endpoint.changed",
      "at": 1793577619,
      "data": {
       "endpoint": {
        "id": "ep_a",
        "merchant_id": "m_acme",
        "url": "{receiver}/hooks/ep_a",
        "secret": "whsec_Lf0hjvpA9Yjr9SGd+mVfJKRb0vf11fJE",
        "event_types": [
         "*"
        ],
        "enabled": true,
        "version": 4
       }
      }
     }
    },
    {
     "at": 22,
     "do": "drain"
    },
    {
     "at": 60,
     "do": "event",
     "ref": "e1",
     "merchant": "m_acme",
     "type": "payment.captured",
     "amount_minor": 1250,
     "currency": "USD"
    },
    {
     "at": 61,
     "do": "drain"
    }
   ],
   "expect": [
    {
     "status": "newer",
     "is": 200
    },
    {
     "status": "older",
     "is": 200
    },
    {
     "endpoint": "ep_a",
     "requests": 0
    }
   ]
  }
 ],
