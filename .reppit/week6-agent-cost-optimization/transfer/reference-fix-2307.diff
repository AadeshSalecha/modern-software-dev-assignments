+def apply_resend(db, log, now, body, producer=None, ident=None):
+    """A resend request is one new delivery, whether or not the endpoint had the event before.
+
+    The only requests that create nothing name an event or an endpoint the router does not
+    have, or an endpoint of another merchant than the event's.
+    """
+    event_id, endpoint_id = body["event_id"], body["endpoint_id"]
+    event = db.execute("select merchant_id from events where id = ?", (event_id,)).fetchone()
+    endpoint = db.execute("select merchant_id from endpoints where id = ?", (endpoint_id,)).fetchone()
+    if event is None or endpoint is None or event["merchant_id"] != endpoint["merchant_id"]:
+        reason = "unknown" if event is None or endpoint is None else "merchant"
+        log.write("resend.skipped", level="warn", event=event_id, endpoint=endpoint_id, reason=reason)
+        return
+    # A request is known by the message that first carried it. A message with `request` repeats
+    # a request an earlier release has already applied (and recorded nowhere).
+    repeated = body.get("request") is not None
+    request = str(body["request"]) if repeated else str(ident)
+    producer = producer or ""
+    if db.execute(
+        "select 1 from resend_requests where producer = ? and request = ?", (producer, request)
+    ).fetchone():
