+  // it took into the outbox. `request` names the message that first carried the request, so
+  // the router gives a delivery only to the ones that never got theirs.
+  repeatResends(now: number): void {
+    const done = this.db
+      .prepare("select value from meta where key = 'resends_repeated'")
+      .get();
+    if (done) return;
+    const rows = this.db
+      .prepare(
+        "select seq, data from outbox where type = 'resend.requested' order by seq",
+      )
+      .all() as { seq: number; data: string }[];
+    for (const row of rows) {
+      const data = JSON.parse(row.data) as Record<string, unknown>;
+      if (data.request !== undefined) continue;
+      this.enqueue("resend.requested", now, {
+        event_id: data.event_id,
+        endpoint_id: data.endpoint_id,
+        request: row.seq,
+      });
+    }
+    this.db
+      .prepare("insert into meta (key, value) values ('resends_repeated', 1)")
+      .run();
+  }
