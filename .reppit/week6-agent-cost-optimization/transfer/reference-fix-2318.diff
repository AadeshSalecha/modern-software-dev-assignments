+  // INC-2318. Releases up to 2.3.1 did not give an endpoint that was switched back on
+  // the events accepted more than 24 hours before the switch-on. The outbox holds every
+  // message in the order the router applied them, so it says which events each endpoint
+  // was owed at each switch-on. The router is told once; it makes a delivery only for
+  // an event that has none to that endpoint.
+  recoverSkipped(now: number): void {
+    const done = this.db
+      .prepare("select 1 from meta where key = 'inc2318_recovered'")
+      .get();
+    if (done) return;
+    const rows = this.db
+      .prepare(
+        "select type, data from outbox where status != 'rejected' and type in ('endpoint.changed', 'event.accepted') order by seq",
+      )
+      .all() as { type: string; data: string }[];
+    const seen = new Map<
+      string,
+      { merchant: string; enabled: boolean; waiting: { id: string; type: string }[] }
+    >();
+    const owed = new Map<string, string[]>();
+    for (const row of rows) {
+      const data = JSON.parse(row.data);
+      if (row.type === "endpoint.changed") {
+        const next = data.endpoint as Endpoint;
+        const before = seen.get(next.id);
+        if (!before) {
+          seen.set(next.id, {
+            merchant: next.merchant_id,
+            enabled: next.enabled,
+            waiting: [],
+          });
+          continue;
+        }
+        if (!before.enabled && next.enabled) {
+          const list = owed.get(next.id) ?? [];
+          for (const event of before.waiting) {
+            if (
+              next.event_types.includes("*") ||
+              next.event_types.includes(event.type)
+            )
+              list.push(event.id);
+          }
+          owed.set(next.id, list);
+          before.waiting = [];
+        }
+        before.enabled = next.enabled;
+      } else {
+        const event = data.event as EventRecord;
+        for (const endpoint of seen.values()) {
+          if (!endpoint.enabled && endpoint.merchant === event.merchant_id)
+            endpoint.waiting.push({ id: event.id, type: event.type });
+        }
+      }
+    }
+    for (const [id, events] of owed) {
+      const endpoint = this.endpoint(id);
+      if (endpoint && events.length > 0)
+        this.enqueue("endpoint.changed", now, { endpoint, owed: events });
+    }
+    this.db
+      .prepare("insert into meta (key, value) values ('inc2318_recovered', 1)")
+      .run();
+  }
