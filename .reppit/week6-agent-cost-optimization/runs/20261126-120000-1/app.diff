+  // Tell the router about every event that repeats an earlier event's
+  // idempotency key, once each. Safe to run on every start.
+  announceRepeats(now: number): void {
+    this.transaction(() => {
+      const rows = this.db
+        .prepare(
+          `select e.id as id, f.id as original from events e
+           join events f on f.merchant_id = e.merchant_id and f.idempotency_key = e.idempotency_key
+             and f.rowid = (select min(rowid) from events g where g.merchant_id = e.merchant_id and g.idempotency_key = e.idempotency_key)
+           where e.idempotency_key is not null and e.rowid > f.rowid
+             and e.id not in (select event_id from repeat_notices)
+           order by e.rowid`,
+        )
+        .all() as { id: string; original: string }[];
+      for (const r of rows) {
+        this.db.prepare("insert into repeat_notices (event_id) values (?)").run(r.id);
+        this.enqueue("event.repeated", now, { event_id: r.id, original_id: r.original });
+      }
+    });
+  }
