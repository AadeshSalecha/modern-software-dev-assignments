# keep-mcp configuration. Copy to `.env` (gitignored) to override a default.
# Every value has a documented default below; the server runs with no env vars
# at all. The client secret and tokens never go into the repo.

# Desktop OAuth client JSON downloaded from Google Cloud Console (contains the
# client id + secret). Used by `keep-mcp login` and by the silent refresh.
# Default: ~/.config/keep-mcp/client_secret.json (chmod 600)
KEEP_OAUTH_CLIENT_FILE=~/.config/keep-mcp/client_secret.json

# Cached refresh/access token written by `keep-mcp login` (mode 0600).
# Default: ~/.local/state/keep-mcp/token.json
KEEP_TOKEN_FILE=~/.local/state/keep-mcp/token.json

# Registry of the notes keep-mcp created; the safe-mode delete guard reads it.
# Default: ~/.local/state/keep-mcp/managed_notes.json
KEEP_STATE_FILE=~/.local/state/keep-mcp/managed_notes.json

# Service account whose domain-wide delegation grant authorizes the Keep scope.
# Default: keep-mcp-probe@keep-mcp-week2.iam.gserviceaccount.com
KEEP_DWD_SERVICE_ACCOUNT=keep-mcp-probe@keep-mcp-week2.iam.gserviceaccount.com

# true (default): refuse to delete notes keep-mcp did not create.
KEEP_SAFE_MODE=true
