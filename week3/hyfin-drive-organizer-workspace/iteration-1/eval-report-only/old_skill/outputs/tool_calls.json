[
 {
  "name": "Read",
  "input": {
   "file_path": "<scratch path>"
  }
 },
 {
  "name": "ToolSearch",
  "input": {
   "query": "select:mcp__Google_Drive__search_files,mcp__Google_Drive__get_file_metadata,mcp__Google_Drive__get_file_permissions,mcp__Google_Drive__list_recent_files",
   "max_results": 4
  }
 },
 {
  "name": "mcp__Google_Drive__get_file_metadata",
  "input": {
   "fileId": "<shared_drive_root id>",
   "excludeContentSnippets": true
  }
 },
 {
  "name": "mcp__Google_Drive__get_file_permissions",
  "input": {
   "fileId": "<shared_drive_root id>"
  }
 },
 {
  "name": "mcp__Google_Drive__search_files",
  "input": {
   "query": "owner = 'me' and mimeType != 'application/vnd.google-apps.folder'",
   "pageSize": 100,
   "excludeContentSnippets": true
  }
 },
 {
  "name": "mcp__Google_Drive__search_files",
  "input": {
   "query": "mimeType = 'application/vnd.google-apps.folder' and (title contains '00-Needs-Review' or title contains '01-Guarantees' or title contains '02-Funds' or title contains '03-GAIA' or title contains '04-Fund-Forge' or title contains '05-BUS' or title contains '06-Org-Team')",
   "pageSize": 50,
   "excludeContentSnippets": true
  }
 },
 {
  "name": "mcp__Google_Drive__get_file_metadata",
  "input": {
   "fileId": "<my_drive_root id>",
   "excludeContentSnippets": true
  }
 },
 {
  "name": "mcp__Google_Drive__search_files",
  "input": {
   "query": "parentId = 'root' and mimeType != 'application/vnd.google-apps.folder'",
   "pageSize": 100,
   "excludeContentSnippets": true
  }
 },
 {
  "name": "mcp__Google_Drive__search_files",
  "input": {
   "query": "parentId = '<03-GAIA id>' and mimeType = 'application/vnd.google-apps.folder'",
   "pageSize": 50,
   "excludeContentSnippets": true
  }
 },
 {
  "name": "mcp__Google_Drive__get_file_permissions",
  "input": {
   "fileId": "<test_gaia id>"
  }
 }
]